{
    "name": "ernestdefoe/mobile-tab",
    "description": "A configurable mobile bottom tab bar for Flarum 2.x — build your own tabs (icon, label, destination), a raised center action, and a logo/favicon slot.",
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernestdefoe",
            "email": "ernestdefoe@gmail.com",
            "role": "Maintainer"
        },
        {
            "name": "resofire",
            "role": "Original author"
        }
    ],
    "support": {
        "issues": "https://github.com/ernestdefoe/mobiletab/issues",
        "source": "https://github.com/ernestdefoe/mobiletab"
    },
    "require": {
        "flarum/core": "^2.0"
    },
    "extra": {
        "flarum-extension": {
            "title": "Mobile Tab Bar",
            "category": "theme",
            "icon": {
                "name": "fas fa-bars",
                "backgroundColor": "#69c6b9",
                "color": "#1A2744"
            }
        }
    }
}
